{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-sim",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && DB_PATH=../personal/sim.db WORKER=0 uv run uvicorn app.main:app --port 8001"
      ],
      "port": 8001
    },
    {
      "name": "web-sim",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && API_TARGET=http://127.0.0.1:8001 npx vite --port 5174 --strictPort"
      ],
      "port": 5174
    },
    {
      "name": "web-live",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx vite --port 5173 --strictPort"
      ],
      "port": 5173
    },
    {
      "name": "desk-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && DB_PATH=../personal/preview.db WORKER=0 uv run uvicorn app.main:app --port 8002"
      ],
      "port": 8002
    }
  ]
}
