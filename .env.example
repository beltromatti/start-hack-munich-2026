# Model access: OpenAI key from the hackathon credits, or the challenge's LLM gateway.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna

# Structured stage calls (backend/app/ai): per-stage model, optional
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_EXTRACTION_MODEL=gpt-6-luna
# LLM_WRITING_MODEL=gpt-6.1-sol
# LLM_WRITING_EFFORT=medium
# LLM_WRITING_MAX_TOKENS=4000

# Hard stop at 90 % of this budget (USD). Empty = no limit.
LLM_BUDGET_USD=15

# Background worker (polls the mailbox / portal)
WORKER=0
POLL_SECONDS=20
MAIL_ADAPTER=fake

# Challenge keys go below (portal API key, mailbox API key, ...)
