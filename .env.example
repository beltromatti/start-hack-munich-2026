# 5U kit card (team key: ask Jan or Mattia, never commit it). One key for mailbox, portal and gateway.
FIVEU_BASE_URL=https://api.start-hack.5u.ai
FIVEU_API_KEY=

# Production LLM: the 5U gateway with the team key. Only these calls count for the cost score.
LLM_BASE_URL=https://api.start-hack.5u.ai/v1/gateway
LLM_API_KEY=

# Dev and tests: LLM_TARGET=openai calls OpenAI directly with this key (never counted as our spend).
OPENAI_API_KEY=
# LLM_TARGET=gateway

# Models per step (defaults shown)
# LLM_MODEL_PARSE=gpt-6-luna
# LLM_MODEL_BID=gpt-5-nano
# LLM_MODEL_WRITE=gpt-6-luna

# Forwarder loop (make live sets WORKER=1)
POLL_SECONDS=1.5
BID_WAIT_SECONDS=85
PERSONA_NAME=Giulia

# Team password for the UI and API on a public address (the server). Empty on a laptop.
UI_PASSWORD=
